{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/_shell.html"
    },
    {
      "source": "/blog/",
      "destination": "/_shell.html"
    },
    {
      "source": "/heimlog",
      "destination": "/_shell.html"
    },
    {
      "source": "/heimlog/",
      "destination": "/_shell.html"
    },
    {
      "source": "/en/blog",
      "destination": "/en/_shell.html"
    },
    {
      "source": "/en/blog/",
      "destination": "/en/_shell.html"
    },
    {
      "source": "/en/heimlog",
      "destination": "/en/_shell.html"
    },
    {
      "source": "/en/heimlog/",
      "destination": "/en/_shell.html"
    }
  ]
}
