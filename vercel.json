{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/en/(.*)",
      "destination": "/en/_shell.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/_shell.html"
    }
  ]
}
