{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/data/speaker-separated",
      "destination": "/data/multi-speaker",
      "permanent": true
    },
    {
      "source": "/en/data/speaker-separated",
      "destination": "/en/data/multi-speaker",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/en/(.*)",
      "destination": "/en/_shell.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/_shell.html"
    }
  ]
}
