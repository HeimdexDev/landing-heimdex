# Slack Incoming Webhook for contact/CRM lead notifications.
# Server-side only (used by the /api/contact serverless function). Do NOT prefix with VITE_.
SLACK_CRM_WEBHOOK_URL=<REPLACE_WITH_YOUR_SLACK_WEBHOOK_URL>

# HubSpot Forms API: creates a contact + triggers the HubSpot auto-reply mail per submission.
# Server-side only. Leave unset to disable (local dev). On Vercel, scope these to PRODUCTION only,
# or every Preview deployment's form creates real HubSpot contacts and sends real mail.
HUBSPOT_PORTAL_ID=<REPLACE_WITH_HUBSPOT_PORTAL_ID>
HUBSPOT_FORM_GUID=<REPLACE_WITH_HUBSPOT_FORM_GUID>
# Optional: the marketing subscription type id. Unset = only processing consent is sent.
HUBSPOT_MARKETING_SUBSCRIPTION_TYPE_ID=

# GA4 Measurement ID for the Marketing property (heimdex.co + blog.heimdex.co).
# Client-side, so it MUST use the VITE_ prefix. Leave unset to disable tracking (no-op).
VITE_GA4_MEASUREMENT_ID=<REPLACE_WITH_GA4_MEASUREMENT_ID>
